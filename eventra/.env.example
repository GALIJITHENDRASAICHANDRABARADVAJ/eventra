# ---------------------------------------------------------------------------
# Eventra environment template. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Frontend (public, baked into the browser bundle: no secrets here) ---
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_APP_NAME=Eventra
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev            # dev = demo data + mock payments; prod = neither
DATABASE_URL=jdbc:postgresql://localhost:5432/eventra
DATABASE_USERNAME=eventra
DATABASE_PASSWORD=eventra

JWT_SECRET=+yD6qTdVWi42iK9DelY6f+3fw9jzLp8x17W6ykXN08I=
JWT_ACCESS_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P14D
QR_SIGNING_SECRET=ftroXeXm31Nanf2K5926vvx0DBKVYrt94It0i3CTDf0=
COOKIE_SECURE=false                   # true in production (HTTPS)

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Demo accounts (dev profile only): demo@ / admin@ / staff@ / partner@eventra.com
DEMO_USER_PASSWORD=Demo@12345

# Payments. Leave blank to disable a gateway. Mock gateway is on in the dev profile.
PAYMENTS_MOCK_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENVIRONMENT=SANDBOX            # SANDBOX | PRODUCTION
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Email: console (logs emails) or smtp
EMAIL_PROVIDER=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=Eventra <no-reply@eventra.example>

# Business policy (optional overrides)
SEAT_LOCK_DURATION=PT5M
CANCELLATION_CUTOFF_MINUTES=120
CONVENIENCE_FEE_PER_TICKET=25
TAX_RATE_ON_FEE=0.18
